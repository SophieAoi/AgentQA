# Copy to .env and fill in. .env is gitignored.

# Phase 8: all reasoning (chat, Planner, Executor, Verifier) runs against a
# local Ollama server — no paid third-party model API. Install Ollama
# (brew install ollama / brew services start ollama), then
# `ollama pull qwen2.5:14b-instruct` before starting the backend.
# 14B (~9GB) is the default because it fits fully on GPU on typical
# 16-24GB unified-memory laptops. Only switch to qwen2.5:32b-instruct if
# `ollama ps` shows the model staying mostly on GPU on your machine —
# otherwise Ollama falls back to slow, hot CPU compute for the overflow.
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:14b-instruct
# How long Ollama keeps the model loaded after the last request. Raise this
# (e.g. "1h") if runs are often more than 30 minutes apart and you don't
# mind the model sitting in memory idle; lower it to free up RAM sooner.
LOCAL_LLM_KEEP_ALIVE=30m

# Required for real Playwright test runs (Phase 2).
INFLUENCE_BASE_URL=https://influence-stg.movingwalls.com
INFLUENCE_TEST_USERNAME=
INFLUENCE_TEST_PASSWORD=
# Campaign that new Line Items get created under during test runs.
INFLUENCE_TEST_CAMPAIGN_ID=

# Set to false to watch the browser locally instead of running headless.
PLAYWRIGHT_HEADLESS=true

# Wall-clock ceiling per test case, in seconds. The local model (phase 8) is
# slower per call than Claude was — raise this if a specific test case still
# times out (e.g. a long multi-step case against a complex real page).
TEST_CASE_TIMEOUT_SECONDS=900

# Required for Phase 7 auth — the first account, auto-created on startup if
# no users exist yet. Pick your own username/password here; unrelated to the
# local LLM settings above. Set SESSION_COOKIE_SECURE=true once this is ever
# deployed behind real TLS (it must stay false for local http://localhost).
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=86400
